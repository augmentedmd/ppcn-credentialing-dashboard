{
  "name": "ppcn-credentialing-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "PeakPoint Central Nassau physician credentialing status dashboard with governing board voting",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute ppcn-credentialing --local --file=./migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute ppcn-credentialing --remote --file=./migrations/0001_init.sql",
    "db:seed:local": "wrangler d1 execute ppcn-credentialing --local --file=./migrations/0002_seed.sql",
    "db:seed:remote": "wrangler d1 execute ppcn-credentialing --remote --file=./migrations/0002_seed.sql",
    "db:demo:local": "wrangler d1 execute ppcn-credentialing --local --file=./migrations/0003_demo_packets.sql",
    "db:demo:remote": "wrangler d1 execute ppcn-credentialing --remote --file=./migrations/0003_demo_packets.sql",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "typescript": "^5.9.2",
    "wrangler": "^4.37.0"
  }
}
